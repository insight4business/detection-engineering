// ======================================================================
// id: KQL-010
// name: Key Vault secret access from a new caller
// description: A caller identity or IP reads many secrets from a vault and was not seen reading from it
//    during the baseline period.
// platform: Microsoft Sentinel
// schedule: every 1h, lookback 1d with 14d baseline
// mitre_tactic: Credential Access
// mitre_technique: T1555.006 Credentials from Password Stores: Cloud Secrets Management Stores
// severity: High
// data_source: AzureDiagnostics
// false_positives: New application deployments, new CI runners, scale-out events and failover to another
//    region.
// tuning: Exclude known deployment identities; lengthen the baseline; validate column names for
//    the diagnostic log schema you use.
// test_method: Read several secrets from a lab vault using a new identity or from a new IP.
// owner: <OWNER>
// status: Draft
// last_review: 2026-11-19
// ======================================================================
let lookback = 1d;
let baseline = 14d;
let min_reads = 10;
let KvReads = AzureDiagnostics
    | where TimeGenerated > ago(baseline)
    | where ResourceProvider == "MICROSOFT.KEYVAULT"
    | where OperationName in ("SecretGet", "SecretList", "SecretBackup")
    | where ResultSignature =~ "OK"
    | extend Vault = tostring(Resource),
             CallerApp = tostring(column_ifexists("identity_claim_appid_g", "")),
             CallerOid = tostring(column_ifexists("identity_claim_oid_g", ""))
    | extend CallerId = strcat(CallerApp, "|", CallerOid)
    | project TimeGenerated, Vault, CallerId, CallerIP = CallerIPAddress, OperationName;
let Baseline = KvReads
    | where TimeGenerated < ago(lookback)
    | distinct Vault, CallerId, CallerIP;
KvReads
| where TimeGenerated >= ago(lookback)
| summarize Reads = count(), FirstRead = min(TimeGenerated), LastRead = max(TimeGenerated), Operations = make_set(OperationName)
    by Vault, CallerId, CallerIP
| where Reads >= min_reads
| join kind=leftanti Baseline on Vault, CallerId, CallerIP
| project FirstRead, LastRead, Vault, CallerId, CallerIP, Reads, Operations
