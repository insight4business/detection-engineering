```
id: SPL-014
name: Suspicious PowerShell command line
description: PowerShell started with encoded commands, download cradles or evasion switches.
platform: Splunk
mitre_tactic: Execution
mitre_technique: T1059.001 Command and Scripting Interpreter: PowerShell
severity: Medium
data_source: index=sysmon (process creation)
false_positives: Management scripts using encoded commands; deployment tools.
tuning: Allow-list parent processes; use a minimum indicator score.
test_method: Run an encoded harmless command with -NoProfile on a test endpoint.
owner: <OWNER>
status: Draft
last_review: 2026-11-19
```
index=sysmon sourcetype="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 (Image="*\\powershell.exe" OR Image="*\\pwsh.exe") earliest=-1h
| eval enc=if(match(CommandLine,"(?i)\s-e(nc|ncodedcommand)?\s+[A-Za-z0-9+/=]{20,}"),1,0)
| eval cradle=if(match(CommandLine,"(?i)(downloadstring|downloadfile|invoke-webrequest|net\.webclient|start-bitstransfer)"),1,0)
| eval iex=if(match(CommandLine,"(?i)(\biex\b|invoke-expression)"),1,0)
| eval evasion=if(match(CommandLine,"(?i)-(nop|noprofile|w(indowstyle)?\s+hidden|ep\s+bypass|executionpolicy\s+bypass)"),1,0)
| eval score=enc+cradle+iex+evasion
| where score>=2
| table _time host User ParentImage score CommandLine
| sort - score
