// ======================================================================
// id: KQL-005
// name: Password spray: few attempts across many accounts
// description: One source IP fails authentication against many distinct accounts with a low number of
//    attempts per account.
// platform: Microsoft Sentinel
// schedule: every 15m, lookback 1h
// mitre_tactic: Credential Access
// mitre_technique: T1110.003 Brute Force: Password Spraying
// severity: High
// data_source: SigninLogs
// false_positives: Corporate NAT egress where many users mistype after a password policy change;
//    misconfigured devices retrying with old credentials.
// tuning: Add the corporate egress IPs to an exclusion watchlist; tune min_distinct_users to
//    tenant size.
// test_method: From one IP, try a single wrong password against ten or more lab accounts.
// owner: <OWNER>
// status: Draft
// last_review: 2026-11-19
// ======================================================================
let lookback = 1h;
let min_distinct_users = 10;
let max_avg_attempts_per_user = 3.0;
let spray_codes = dynamic(["50126", "50034"]);   // invalid password, user not found
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in (spray_codes)
| summarize Attempts = count(),
            DistinctUsers = dcount(UserPrincipalName),
            UserSample = make_set(UserPrincipalName, 10),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IPAddress
| extend AvgAttemptsPerUser = round(todouble(Attempts) / DistinctUsers, 1)
| where DistinctUsers >= min_distinct_users and AvgAttemptsPerUser <= max_avg_attempts_per_user
| project FirstSeen, LastSeen, IPAddress, DistinctUsers, Attempts, AvgAttemptsPerUser, UserSample
