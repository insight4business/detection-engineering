// ======================================================================
// id: KQL-009
// name: Credential added to application or service principal
// description: A new secret or certificate is added to an application or service principal, a common
//    persistence step.
// platform: Microsoft Sentinel
// schedule: every 15m, lookback 1h
// mitre_tactic: Persistence
// mitre_technique: T1098.001 Account Manipulation: Additional Cloud Credentials
// severity: High
// data_source: AuditLogs
// false_positives: Planned secret rotation by the application owner or automation.
// tuning: Exclude the rotation automation identity; alert only when the actor is not the
//    application owner.
// test_method: Add a client secret to a lab app registration.
// owner: <OWNER>
// status: Draft
// last_review: 2026-11-19
// ======================================================================
let lookback = 1h;
AuditLogs
| where TimeGenerated > ago(lookback)
| where OperationName == "Add service principal credentials"
    or OperationName has "Certificates and secrets management"
| where Result == "success"
| extend Actor = coalesce(tostring(InitiatedBy.user.userPrincipalName), tostring(InitiatedBy.app.displayName)),
         ActorIP = tostring(InitiatedBy.user.ipAddress),
         ActorIsApp = isnotempty(tostring(InitiatedBy.app.displayName)),
         AppName = tostring(TargetResources[0].displayName),
         Change = tostring(TargetResources[0].modifiedProperties)
| project TimeGenerated, OperationName, Actor, ActorIP, ActorIsApp, AppName, Change, CorrelationId
