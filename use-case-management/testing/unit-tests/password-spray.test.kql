// Unit test for KQL-005 (password spray) using synthetic events.
// The let statement shadows the real table, so the aggregation logic can be tested without live data.
// The time filter of the rule is omitted because the sample timestamps are fixed.
// Expected result: exactly one row, IPAddress 198.51.100.7, DistinctUsers 12, AvgAttemptsPerUser 1.0.
// The address 198.51.100.99 (one user, two failures) must NOT appear.
let SigninLogs = datatable(TimeGenerated:datetime, UserPrincipalName:string, IPAddress:string, ResultType:string)
[
    datetime(2026-01-15 10:01:00), "user01@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:02:00), "user02@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:03:00), "user03@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:04:00), "user04@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:05:00), "user05@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:06:00), "user06@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:07:00), "user07@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:08:00), "user08@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:09:00), "user09@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:10:00), "user10@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:11:00), "user11@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:12:00), "user12@contoso.com", "198.51.100.7", "50126",
    datetime(2026-01-15 10:30:00), "user01@contoso.com", "198.51.100.99", "50126",
    datetime(2026-01-15 10:31:00), "user01@contoso.com", "198.51.100.99", "50126"
];
let min_distinct_users = 10;
let max_avg_attempts_per_user = 3.0;
let spray_codes = dynamic(["50126", "50034"]);
SigninLogs
| where ResultType in (spray_codes)
| summarize Attempts = count(), DistinctUsers = dcount(UserPrincipalName) by IPAddress
| extend AvgAttemptsPerUser = round(todouble(Attempts) / DistinctUsers, 1)
| where DistinctUsers >= min_distinct_users and AvgAttemptsPerUser <= max_avg_attempts_per_user
